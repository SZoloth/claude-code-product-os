#!/usr/bin/env bash
# direnv for PERSONAL context — ensure no Anthropic proxy vars leak in

unset ANTHROPIC_BASE_URL
unset ANTHROPIC_API_KEY
unset ANTHROPIC_DEFAULT_SONNET_MODEL
unset ANTHROPIC_DEFAULT_MODEL

# Optional: set a default personal model for tools that read env (Claude wrapper already handles this)
# export CLAUDE_PERSONAL_DEFAULT_MODEL="claude-3-5-sonnet-20240620"

